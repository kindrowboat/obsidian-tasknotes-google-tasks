{
  "name": "obsidian-tasknotes-google-tasks",
  "version": "0.1.0",
  "description": "Two-way sync between TaskNotes and Google Tasks.",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "package": "npm run build && node scripts/package.mjs",
    "test": "tsx --test tests/*.test.ts",
    "version": "node scripts/version-bump.mjs && git add manifest.json versions.json",
    "publish-plugin": "node scripts/publish.mjs"
  },
  "keywords": ["obsidian", "tasknotes", "google-tasks"],
  "author": "Stef Dunlap",
  "license": "SEE LICENSE IN LICENSE",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^5.0.0",
    "esbuild": "^0.28.0",
    "obsidian": "^1.14.0",
    "tslib": "^2.8.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.0"
  }
}
